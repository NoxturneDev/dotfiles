#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time

STATE_DIR = "/tmp/yabai_window_states"
os.makedirs(STATE_DIR, exist_ok=True)

def run(cmd):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return ""

def main():
    raw_win = run(["yabai", "-m", "query", "--windows", "--window"])
    if not raw_win:
        sys.exit(0)

    win = json.loads(raw_win)
    win_id = win["id"]
    cur_frame = win["frame"]

    state_file = os.path.join(STATE_DIR, f"win_{win_id}.json")

    # Clean up old states in /tmp (> 24 hours)
    now = time.time()
    for f in os.listdir(STATE_DIR):
        fp = os.path.join(STATE_DIR, f)
        if os.path.isfile(fp) and (now - os.path.getmtime(fp)) > 86400:
            try:
                os.remove(fp)
            except OSError:
                pass

    # If state file exists, restore previous size
    if os.path.exists(state_file):
        try:
            with open(state_file, "r") as f:
                prev = json.load(f)
            os.remove(state_file)
            px, py, pw, ph = int(prev["x"]), int(prev["y"]), int(prev["w"]), int(prev["h"])
            run(["yabai", "-m", "window", str(win_id), "--move", f"abs:{px}:{py}"])
            run(["yabai", "-m", "window", str(win_id), "--resize", f"abs:{pw}:{ph}"])
            sys.exit(0)
        except Exception:
            pass

    # Otherwise save current frame and maximize with gaps (1:1 grid)
    with open(state_file, "w") as f:
        json.dump(cur_frame, f)

    run(["yabai", "-m", "window", str(win_id), "--grid", "1:1:0:0:1:1"])

if __name__ == "__main__":
    main()
